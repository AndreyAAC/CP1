@{
    var title = ViewData["Title"] as string ?? "CP1.Mvc";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@title - Caso Practico #1</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/CP1.Mvc.styles.css" asp-append-version="true" />
    @RenderSection("Styles", required: false)
</head>
<body>
    <nav class="navbar navbar-expand-lg border-bottom sticky-top bg-body">
        <div class="container-fluid">
            <a class="navbar-brand fw-semibold" asp-controller="Home" asp-action="Index">Caso Practico #1</a>
            <div class="ms-auto d-flex align-items-center gap-2">
                @RenderSection("TopbarRight", required: false)
            </div>
        </div>
    </nav>

    <main class="container-fluid py-4">
        @RenderBody()
    </main>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>