@model CP1.Models.DTOs.TaskDTO
@await Html.PartialAsync("~/Views/Shared/_Sidebar.cshtml")
<div class="container py-3">
    <h2>Agregar tarea</h2>
    <form method="post">
        <div class="mb-3">
            <label class="form-label">Nombre</label>
            <input class="form-control" name="Name" required />
        </div>
        <div class="mb-3">
            <label class="form-label">Descripción</label>
            <textarea class="form-control" name="Description"></textarea>
        </div>
        <div class="mb-3">
            <label class="form-label">Creado por</label>
            <input class="form-control" name="CreatedBy" />
        </div>

        <div class="form-check mb-3">
            @Html.CheckBoxFor(t => t.Status, new { @class = "form-check-input", id = "statusCheck" })
            <label class="form-check-label" for="statusCheck">¿Completada?</label>
        </div>
        <button class="btn btn-primary"><i class="bi bi-save me-1"></i> Guardar</button>
        <a class="btn btn-secondary" href="@Url.Action("Task", "Home")">Cancelar</a>
    </form>
</div>