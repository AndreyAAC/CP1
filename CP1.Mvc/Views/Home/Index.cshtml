@model List<CP1.Models.DTOs.TaskDTO>
@{
    ViewData["Title"] = "Inicio";
    var hasMore = (bool)(ViewBag.HasMore ?? false);
}
@await Html.PartialAsync("~/Views/Shared/_Sidebar.cshtml")

<div class="container py-3">
    <div class="p-5 mb-4 bg-body-tertiary rounded-3">
        <div class="container-fluid py-5">
            <h1 class="display-5 fw-bold">¡Bienvenido a tus Tareas!</h1>
            <p class="col-md-8 fs-5">Organiza, crea y gestiona tus tareas.</p>
            <a class="btn btn-primary btn-lg" href="@Url.Action("CreateTask", "Home")">
                <i class="bi bi-plus-circle me-2"></i> Crear nueva tarea
            </a>
        </div>
    </div>

    <h3 class="mb-3">Summary</h3>
    <div class="list-group">
        @foreach (var t in Model)
        {
            <div class="list-group-item list-group-item-action">
                <div class="d-flex w-100 justify-content-between">
                    <h5 class="mb-1">@t.Name</h5>
                    <small class="text-secondary">@t.Status</small>
                </div>
                <p class="mb-1 text-muted">@t.Description</p>
                <small>Vence: @t.DueDate.ToString("yyyy-MM-dd HH:mm")</small>
            </div>
        }
    </div>

    @if (hasMore)
    {
        <div class="mt-3">
            <a class="btn btn-outline-secondary" href="@Url.Action("Task", "Home")">Ver más</a>
        </div>
    }
</div>