@model List<CP1.Models.DTOs.TaskDTO>
@await Html.PartialAsync("~/Views/Shared/_Sidebar.cshtml")
<div class="container py-3">
    <h2 class="mb-3">Tareas</h2>
    <div class="list-group">
        @foreach (var t in Model)
        {
            <div class="list-group-item">
                <div class="d-flex justify-content-between">
                    <strong>@t.Name</strong>
                    <span class="badge bg-secondary">@t.Status</span>
                </div>
                <div class="text-muted">@t.Description</div>
                <div class="small mt-1">
                    <span class="me-3"><i class="bi bi-calendar2-event"></i> Vence: @t.DueDate.ToString("yyyy-MM-dd HH:mm")</span>
                    <span class="me-3"><i class="bi bi-clock-history"></i> Creada: @(t.CreatedAt?.ToString("yyyy-MM-dd HH:mm") ?? "-")</span>
                    <span><i class="bi bi-check2-square"></i> Aprobada: @(t.Approved == true ? "Sí" : "No")</span>
                </div>
                <div class="mt-2">
                    <a class="btn btn-sm btn-outline-primary" href="@Url.Action("EditTask", "Home", new { id = t.Id })">
                        <i class="bi bi-pencil-square me-1"></i> Editar
                    </a>
                    <a class="btn btn-sm btn-outline-danger" href="@Url.Action("DeleteTask", "Home", new { id = t.Id })">
                        <i class="bi bi-trash3 me-1"></i> Eliminar
                    </a>
                </div>
            </div>
        }
    </div>
</div>